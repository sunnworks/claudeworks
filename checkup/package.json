{
  "name": "deaf-checkup-sign-questionnaire-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "농인용 건강검진 수어 사전문진 데모 (성인 국가건강검진 사전문진)",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "build:zip": "npm run build:standalone && node scripts/build-zip.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "28.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}