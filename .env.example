# 설계서 14 6 환경변수
# 기본 실행은 샘플 모드다. 실제 OCR·아바타 연동 시에만 값을 채운다.

DEMO_MODE=true

# OCR — mock: 등록된 샘플 약봉투와 고정 OCR JSON / live: 실제 OCR 사업자 호출
OCR_PROVIDER=mock
OCR_API_URL=
OCR_API_KEY=

# 아바타 — mock: 데모용 샘플 수어영상 / live: KLcube 아바타 API
AVATAR_PROVIDER=mock
AVATAR_API_URL=
AVATAR_API_KEY=

# 약봉투 이미지 영구 저장 여부 (데모는 항상 false)
SESSION_IMAGE_PERSIST=false

# QR 재열람 — 유효기간은 데모와 운영 모두 48시간으로 고정한다
QR_TTL_HOURS=48
QR_TOKEN_SECRET=change-me-in-production
QR_CLEANUP_INTERVAL_MINUTES=15

# 신뢰도 임계값 (설계서 10 3 작업 가설, 운영 전 조정)
CONFIDENCE_HIGH=0.90
CONFIDENCE_REVIEW=0.75

# QR 주소 생성 기준 URL. 비우면 요청 오리진을 사용한다.
PUBLIC_BASE_URL=
